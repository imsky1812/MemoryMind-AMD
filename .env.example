# MemoryMint — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: "groq" or "sambanova"
LLM_PROVIDER=groq

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_key_here

# SambaNova API key (get from https://cloud.sambanova.ai)
# Only needed if LLM_PROVIDER=sambanova
SAMBANOVA_API_KEY=your_sambanova_key_here

# ─── Model Selection ────────────────────────────────────────────────────────────
# Groq recommended:      llama-3.3-70b-versatile  (best quality)
#                        llama-3.1-8b-instant      (fastest, free tier)
# SambaNova recommended: Meta-Llama-3.1-70B-Instruct
#                        Meta-Llama-3.3-70B-Instruct
LLM_MODEL=llama-3.3-70b-versatile

# ─── Embedding Model ────────────────────────────────────────────────────────────
# BAAI/bge-m3 is the standard 1024-dim model (~2.2 GB, requires ~3-4 GB RAM on CPU).
# For low RAM environments (e.g. 8GB systems), you can use a smaller model:
# - BAAI/bge-small-en-v1.5 (384-dim, English only, ~130MB, very low RAM)
# - intfloat/multilingual-e5-small (384-dim, Multilingual, ~150MB, very low RAM)
# NOTE: Changing this will automatically recreate your Qdrant collection on the next ingest.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── X402 / CDP (Week 2) ────────────────────────────────────────────────────────
# From your downloaded cdp_api_key.json file
# 'id' field from JSON -> CDP_API_KEY_ID
# 'privateKey' field from JSON -> CDP_API_KEY_SECRET
CDP_API_KEY_ID=your_cdp_api_key_id_here
CDP_API_KEY_SECRET=your_cdp_api_key_secret_here

# Filled in automatically or manually after running: python setup_wallet.py
CDP_WALLET_SECRET=your_cdp_wallet_secret_here
WALLET_ADDRESS=your_wallet_address_here
WALLET_ID=your_wallet_id_here

# Payment network configuration (CAIP-2 format)
# Base Sepolia Testnet: eip155:84532
# Base Mainnet: eip155:8453
PAYMENT_NETWORK=eip155:84532
QUERY_PRICE_USD=0.001
