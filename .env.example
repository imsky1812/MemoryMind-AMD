# MemoryMint — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: "groq" or "sambanova"
LLM_PROVIDER=groq

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_key_here

# SambaNova API key (get from https://cloud.sambanova.ai)
# Only needed if LLM_PROVIDER=sambanova
SAMBANOVA_API_KEY=your_sambanova_key_here

# ─── Model Selection ────────────────────────────────────────────────────────────
# Groq recommended:      llama-3.1-70b-versatile  (best quality)
#                        llama-3.1-8b-instant      (fastest, free tier)
# SambaNova recommended: Meta-Llama-3.1-70B-Instruct
#                        Meta-Llama-3.3-70B-Instruct
LLM_MODEL=llama-3.1-70b-versatile

# ─── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
